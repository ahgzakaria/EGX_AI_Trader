# AI Stock Analysis — optional external narrative layer (Layer 2).
# Copy to .env and fill in locally. NEVER commit a real key: .env is git-ignored,
# only this example file is tracked, and no value here is a secret.
#
# With AI_NARRATIVE_ENABLED unset or false, the feature behaves exactly as V1:
# the deterministic Arabic narrative, no provider call, no key required.

AI_NARRATIVE_ENABLED=false
AI_NARRATIVE_PROVIDER=openai
AI_NARRATIVE_MODEL=
AI_NARRATIVE_TIMEOUT_SECONDS=20
AI_NARRATIVE_MAX_RETRIES=1
AI_NARRATIVE_CACHE_ENABLED=true

# Optional: any OpenAI-compatible Responses endpoint. Defaults to https://api.openai.com/v1
AI_NARRATIVE_BASE_URL=

# Secret — leave empty here. The standard variable is used first; AI_NARRATIVE_API_KEY
# is a documented alias for deployments that scope the key to this feature alone.
OPENAI_API_KEY=
AI_NARRATIVE_API_KEY=
