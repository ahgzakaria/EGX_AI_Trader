# AI Stock Analysis — optional narrative layer (Layer 2).
# Copy to .env and adjust locally. NEVER commit a real key: .env is git-ignored,
# only this example file is tracked, and no value here is a secret.
#
# With AI_NARRATIVE_ENABLED unset or false, the feature behaves exactly as V1:
# the deterministic Arabic narrative, no provider call, nothing to install.
#
# The operational provider is OLLAMA — free, local, offline, no API key.
# Install the model manually before enabling it (nothing is downloaded for you):
#   ollama pull qwen3:4b
#   ollama run qwen3:4b        # optional smoke test
#   ollama pull qwen3:8b       # optional, larger, higher quality

AI_NARRATIVE_ENABLED=false
AI_NARRATIVE_PROVIDER=ollama
AI_NARRATIVE_MODEL=qwen3:4b
AI_NARRATIVE_TIMEOUT_SECONDS=60
AI_NARRATIVE_MAX_RETRIES=0
AI_NARRATIVE_CACHE_ENABLED=true

# --- Ollama (local only) ---------------------------------------------------- #
# Loopback endpoint. Ollama Cloud is never used. A non-local URL is refused
# unless AI_NARRATIVE_OLLAMA_ALLOW_REMOTE is explicitly turned on.
AI_NARRATIVE_OLLAMA_URL=http://127.0.0.1:11434
AI_NARRATIVE_OLLAMA_TEMPERATURE=0.2
AI_NARRATIVE_OLLAMA_KEEP_ALIVE=5m
AI_NARRATIVE_OLLAMA_DISABLE_THINKING=true
AI_NARRATIVE_OLLAMA_ALLOW_REMOTE=false

# --- OpenAI (available but DISABLED; costs money) ---------------------------- #
# Only used when AI_NARRATIVE_PROVIDER=openai. Leave the keys blank here.
AI_NARRATIVE_BASE_URL=
OPENAI_API_KEY=
AI_NARRATIVE_API_KEY=

# ============================================================================ #
# Market data providers
# ============================================================================ #
# Read by the code but undocumented until now, which is how a machine ends up
# with a key set under one spelling and the code reading the other. Leave every
# key blank here; real values belong in .env, which is git-ignored.

# EODHD — the paid daily-history subscription. Both spellings are read; set the
# one your account uses. Backtests never touch this: they read the frozen
# MubasherTrade PRO record (core/frozen_mubasher_store.py).
EODHD_API_KEY=
EODHD_API_TOKEN=

# TwelveData — evaluated, not operational. Blank leaves the provider inert.
TWELVEDATA_API_KEY=

# --- Rubix (local SQLite quote feed) ---------------------------------------- #
# Path overrides for a non-default install. Unset means the discovered location.
RUBIX_DB_PATH=
# How old a quote or a minute bar may be before it is reported stale rather
# than served. Seconds.
RUBIX_QUOTE_STALE_SECONDS=
RUBIX_BAR_STALE_SECONDS=
# Read timeout for one Rubix query, in milliseconds.
RUBIX_READ_TIMEOUT_MS=

# --- TickerChart ------------------------------------------------------------ #
TICKERCHART_DB_PATH=
TICKERCHART_ADAPTER_PATH=
TICKERCHART_LOCAL_URL=
TICKERCHART_STALE_AFTER_MINUTES=

# ============================================================================ #
# Retired research lanes
# ============================================================================ #
# The ORB and scalping routes were retired on 2026-08-25 on the arithmetic of
# the round trip (see app.py). Their code, collectors and stores remain, and
# these still steer them when they are run by hand. Nothing in the shipped
# dashboard reads them.
ORB_DATA_CONFIG=
ORB_RESEARCH_ROOT=
ORB_RESEARCH_DB_PATH=
ORB_RUBIX_DB_PATH=
SCALPING_HISTORICAL_WATCHLIST_DB=
