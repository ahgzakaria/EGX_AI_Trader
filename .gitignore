# Python
__pycache__/
**/__pycache__/
*.py[cod]
*.pyo
*.pyc

# Virtual Environment
venv/

# VS Code
.vscode/

# Streamlit
.streamlit/

# Runtime market-data cache (recreated automatically)
data/market_data_cache.sqlite*

# Provider response caches (recreated at runtime — never commit)
data/eodhd_cache/
data/yahoo_cache/

# SQLite write-ahead-log / shared-memory sidecar files
*.db-wal
*.db-shm
*.sqlite-wal
*.sqlite-shm
*.sqlite3-wal
*.sqlite3-shm

# Runtime health/status snapshots
data/*_health.json
data/*.pid.json
data/*.lock

# Append-only AI analysis history is runtime production data, never source control.
data/ai_analysis/

# Windows
Thumbs.db

# macOS
.DS_Store

# Secrets / credentials (never commit)
.env
.env.*
!.env.example
*.pem
*.key
secure-temp/

# Databases and runtime state (recreated at runtime — never commit)
*.db
*.sqlite
*.sqlite3

# Rubix launcher: local machine settings and volatile session state. The tracked
# defaults file (config/rubix_launcher_settings.json) stays in Git; these two never do,
# so launching or closing the launcher can no longer dirty the working tree.
config/rubix_launcher_settings.local.json
config/rubix_launcher_settings.local.json.lock
config/rubix_launcher_settings.local.json.tmp*
data/runtime/

# Logs, backups, generated binaries and runtime capture
logs/
backups/
outputs/
*.out
*.err

# Duplicate project snapshot — must not be committed
/EGX_AI_Trader_RC1/

# Local agent/editor tooling config
.claude/

# Generated backtest/run report artifacts (temporary — never commit).
# Keep only the EODHD reconciliation/routing CSVs that code and tests depend on.
reports/
!reports/eodhd/
!reports/eodhd/**

# Rubix assisted start: auth-frame inbox and consumed frames. These hold
# short-lived authentication material selected by the user for one launch.
# They must never be committed, and neither must the local preference file.
data/local/
